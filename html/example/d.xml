<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:baram="http://schemas.baram.com/apk/res/baram"
    baram:layout_width="fill_parent"
    baram:layout_height="fill_parent"
    baram:orientation="vertical"
    baram:background="#E8E8E8">


    <!-- =========================================================
         TITLE BAR
         ========================================================= -->

    <RelativeLayout
        baram:layout_width="fill_parent"
        baram:layout_height="48dip"
        baram:background="#242424"
        baram:paddingLeft="10dip"
        baram:paddingRight="6dip">

        <TextView
            baram:id="@+id/title"
            baram:layout_width="wrap_content"
            baram:layout_height="fill_parent"
            baram:layout_alignParentLeft="true"
            baram:gravity="center_vertical"
            baram:text="System Control Lab"
            baram:textColor="#FFFFFF"
            baram:textSize="18sp"
            baram:textStyle="bold" />

        <Button
            baram:layout_width="70dip"
            baram:layout_height="38dip"
            baram:layout_alignParentRight="true"
            baram:layout_centerVertical="true"
            baram:text="MENU"
            baram:textSize="10sp" />

    </RelativeLayout>


    <!-- =========================================================
         STATUS HEADER
         ========================================================= -->

    <LinearLayout
        baram:layout_width="fill_parent"
        baram:layout_height="58dip"
        baram:orientation="horizontal"
        baram:gravity="center_vertical"
        baram:paddingLeft="10dip"
        baram:paddingRight="10dip"
        baram:background="#89A82C">

        <TextView
            baram:layout_width="45dip"
            baram:layout_height="45dip"
            baram:gravity="center"
            baram:text="A"
            baram:textSize="24sp"
            baram:textStyle="bold"
            baram:textColor="#FFFFFF"
            baram:background="#607A16" />

        <LinearLayout
            baram:layout_width="0dip"
            baram:layout_height="fill_parent"
            baram:layout_weight="1"
            baram:orientation="vertical"
            baram:gravity="center_vertical"
            baram:paddingLeft="10dip">

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:text="baram DEVICE"
                baram:textColor="#FFFFFF"
                baram:textStyle="bold"
                baram:textSize="15sp" />

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:text="System ready"
                baram:textColor="#E8F6C4"
                baram:textSize="11sp" />

        </LinearLayout>

        <ProgressBar
            baram:layout_width="32dip"
            baram:layout_height="32dip"
            baram:indeterminate="true" />

    </LinearLayout>


    <!-- =========================================================
         SCROLL AREA
         ========================================================= -->

    <ScrollView
        baram:layout_width="fill_parent"
        baram:layout_height="0dip"
        baram:layout_weight="1"
        baram:fillViewport="true">

        <LinearLayout
            baram:layout_width="fill_parent"
            baram:layout_height="wrap_content"
            baram:orientation="vertical">


            <!-- =================================================
                 DEVICE INFORMATION
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="DEVICE INFORMATION"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <TableLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:stretchColumns="1"
                baram:background="#FFFFFF"
                baram:padding="6dip">

                <TableRow
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content">

                    <TextView
                        baram:padding="5dip"
                        baram:text="Model"
                        baram:textColor="#555555"
                        baram:textSize="12sp" />

                    <TextView
                        baram:padding="5dip"
                        baram:text="baram Dev Phone"
                        baram:textColor="#111111"
                        baram:textSize="12sp"
                        baram:textStyle="bold" />

                </TableRow>

                <TableRow
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content">

                    <TextView
                        baram:padding="5dip"
                        baram:text="baram"
                        baram:textColor="#555555"
                        baram:textSize="12sp" />

                    <TextView
                        baram:padding="5dip"
                        baram:text="1.0"
                        baram:textColor="#111111"
                        baram:textSize="12sp"
                        baram:textStyle="bold" />

                </TableRow>

                <TableRow
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content">

                    <TextView
                        baram:padding="5dip"
                        baram:text="API"
                        baram:textColor="#555555"
                        baram:textSize="12sp" />

                    <TextView
                        baram:padding="5dip"
                        baram:text="1"
                        baram:textColor="#111111"
                        baram:textSize="12sp"
                        baram:textStyle="bold" />

                </TableRow>

            </TableLayout>


            <!-- =================================================
                 POWER
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="POWER &amp; CONNECTIVITY"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="8dip"
                baram:background="#FFFFFF">

                <CheckBox
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Enable Wi-Fi"
                    baram:textColor="#222222"
                    baram:textSize="14sp"
                    baram:checked="true" />

                <CheckBox
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Enable Bluetooth"
                    baram:textColor="#222222"
                    baram:textSize="14sp" />

                <CheckBox
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Allow background data"
                    baram:textColor="#222222"
                    baram:textSize="14sp"
                    baram:checked="true" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="9dip"
                    baram:text="Mobile network"
                    baram:textColor="#666666"
                    baram:textSize="11sp" />

                <Spinner
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:entries="@array/network_modes" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="10dip"
                    baram:text="Radio power"
                    baram:textColor="#666666"
                    baram:textSize="11sp" />

                <ToggleButton
                    baram:layout_width="130dip"
                    baram:layout_height="wrap_content"
                    baram:textOn="RADIO ON"
                    baram:textOff="RADIO OFF"
                    baram:checked="true" />

            </LinearLayout>


            <!-- =================================================
                 DISPLAY
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="DISPLAY"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="9dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Brightness"
                    baram:textColor="#333333"
                    baram:textSize="13sp"
                    baram:textStyle="bold" />

                <SeekBar
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:max="100"
                    baram:progress="65" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="8dip"
                    baram:text="Interface scale"
                    baram:textColor="#333333"
                    baram:textSize="13sp"
                    baram:textStyle="bold" />

                <Spinner
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:entries="@array/screen_modes" />

            </LinearLayout>


            <!-- =================================================
                 SOUND
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="SOUND"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="9dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Media volume"
                    baram:textSize="13sp"
                    baram:textColor="#222222" />

                <SeekBar
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:max="100"
                    baram:progress="80" />

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Ringer volume"
                    baram:textSize="13sp"
                    baram:textColor="#222222" />

                <SeekBar
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:max="100"
                    baram:progress="55" />

                <CheckBox
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Vibrate on incoming call"
                    baram:checked="true" />

            </LinearLayout>


            <!-- =================================================
                 INPUT TEST
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="INPUT TEST"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="9dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Device name"
                    baram:textColor="#555555"
                    baram:textSize="11sp" />

                <EditText
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="My baram"
                    baram:singleLine="true" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="7dip"
                    baram:text="Test message"
                    baram:textColor="#555555"
                    baram:textSize="11sp" />

                <EditText
                    baram:layout_width="fill_parent"
                    baram:layout_height="80dip"
                    baram:gravity="top|left"
                    baram:text="Type something here..."
                    baram:singleLine="false" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="8dip"
                    baram:text="Auto complete test"
                    baram:textColor="#555555"
                    baram:textSize="11sp" />

                <AutoCompleteTextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:hint="Enter text" />

            </LinearLayout>


            <!-- =================================================
                 RADIO BUTTONS
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="PERFORMANCE MODE"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <RadioGroup
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="8dip"
                baram:background="#FFFFFF">

                <RadioButton
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Power saver" />

                <RadioButton
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Balanced"
                    baram:checked="true" />

                <RadioButton
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Maximum performance" />

            </RadioGroup>


            <!-- =================================================
                 SYSTEM HEALTH
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="SYSTEM HEALTH"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="vertical"
                baram:padding="9dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:text="Battery"
                    baram:textSize="12sp"
                    baram:textColor="#444444" />

                <ProgressBar
                    style="?baram:attr/progressBarStyleHorizontal"
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:max="100"
                    baram:progress="74" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="9dip"
                    baram:text="Storage"
                    baram:textSize="12sp"
                    baram:textColor="#444444" />

                <ProgressBar
                    style="?baram:attr/progressBarStyleHorizontal"
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:max="100"
                    baram:progress="41" />


                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="wrap_content"
                    baram:paddingTop="10dip"
                    baram:text="User rating of this device"
                    baram:textColor="#444444"
                    baram:textSize="12sp" />

                <RatingBar
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:numStars="5"
                    baram:rating="4"
                    baram:stepSize="1" />

            </LinearLayout>


            <!-- =================================================
                 FRAME LAYOUT
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="FRAME LAYOUT TEST"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <FrameLayout
                baram:layout_width="fill_parent"
                baram:layout_height="100dip"
                baram:background="#DDDDDD">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="FRAME"
                    baram:textSize="34sp"
                    baram:textStyle="bold"
                    baram:textColor="#CCCCCC" />

                <TextView
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:layout_gravity="center"
                    baram:padding="8dip"
                    baram:text="Overlay content"
                    baram:textColor="#FFFFFF"
                    baram:textStyle="bold"
                    baram:background="#555555" />

            </FrameLayout>


            <!-- =================================================
                 CLOCK
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="CLOCK &amp; TIMER"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="horizontal"
                baram:gravity="center"
                baram:padding="10dip"
                baram:background="#FFFFFF">

                <AnalogClock
                    baram:layout_width="100dip"
                    baram:layout_height="100dip" />

                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="100dip"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center">

                    <TextView
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="UPTIME"
                        baram:textColor="#777777"
                        baram:textSize="10sp" />

                    <Chronometer
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:textSize="22sp"
                        baram:textStyle="bold"
                        baram:textColor="#222222" />

                </LinearLayout>

            </LinearLayout>


            <!-- =================================================
                 DATE
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="DATE"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />

            <DatePicker
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:background="#FFFFFF" />


            <!-- =================================================
                 TIME
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="TIME"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />

            <TimePicker
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:background="#FFFFFF" />


            <!-- =================================================
                 VIEW FLIPPER
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="VIEW FLIPPER"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <ViewFlipper
                baram:layout_width="fill_parent"
                baram:layout_height="80dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="PAGE 1"
                    baram:textSize="22sp"
                    baram:textStyle="bold"
                    baram:textColor="#555555" />

                <TextView
                    baram:layout_width="fill_parent"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="PAGE 2"
                    baram:textSize="22sp"
                    baram:textStyle="bold"
                    baram:textColor="#555555" />

            </ViewFlipper>


            <!-- =================================================
                 HORIZONTAL SCROLL
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="HORIZONTAL SCROLL"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <HorizontalScrollView
                baram:layout_width="fill_parent"
                baram:layout_height="70dip"
                baram:background="#FFFFFF">

                <LinearLayout
                    baram:layout_width="wrap_content"
                    baram:layout_height="fill_parent"
                    baram:orientation="horizontal"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="5dip"
                    baram:paddingRight="5dip">

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="CPU" />

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="MEMORY" />

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="RADIO" />

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="DISPLAY" />

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="INPUT" />

                    <Button
                        baram:layout_width="100dip"
                        baram:layout_height="50dip"
                        baram:text="SENSOR" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- =================================================
                 ABSOLUTE LAYOUT

                 API 1 に存在。
                 後にdeprecatedになった古参Layout。
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="ABSOLUTE LAYOUT TEST"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <AbsoluteLayout
                baram:layout_width="fill_parent"
                baram:layout_height="125dip"
                baram:background="#DDDDDD">

                <Button
                    baram:layout_width="90dip"
                    baram:layout_height="45dip"
                    baram:layout_x="10dip"
                    baram:layout_y="10dip"
                    baram:text="10,10" />

                <Button
                    baram:layout_width="90dip"
                    baram:layout_height="45dip"
                    baram:layout_x="115dip"
                    baram:layout_y="55dip"
                    baram:text="115,55" />

                <TextView
                    baram:layout_width="100dip"
                    baram:layout_height="30dip"
                    baram:layout_x="215dip"
                    baram:layout_y="15dip"
                    baram:gravity="center"
                    baram:text="X / Y"
                    baram:textColor="#FFFFFF"
                    baram:background="#666666" />

            </AbsoluteLayout>


            <!-- =================================================
                 BUTTON LAB
                 ================================================= -->

            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="30dip"
                baram:gravity="center_vertical"
                baram:paddingLeft="9dip"
                baram:text="BUTTON TEST"
                baram:textColor="#FFFFFF"
                baram:textSize="11sp"
                baram:textStyle="bold"
                baram:background="#666666" />


            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="wrap_content"
                baram:orientation="horizontal"
                baram:padding="8dip"
                baram:background="#FFFFFF">

                <Button
                    baram:layout_width="0dip"
                    baram:layout_height="wrap_content"
                    baram:layout_weight="1"
                    baram:text="TEST" />

                <Button
                    baram:layout_width="0dip"
                    baram:layout_height="wrap_content"
                    baram:layout_weight="1"
                    baram:text="RESET" />

                <Button
                    baram:layout_width="0dip"
                    baram:layout_height="wrap_content"
                    baram:layout_weight="1"
                    baram:text="ABOUT" />

            </LinearLayout>


            <TextView
                baram:layout_width="fill_parent"
                baram:layout_height="40dip"
                baram:gravity="center"
                baram:text="baram System Control Lab 1.0"
                baram:textColor="#888888"
                baram:textSize="10sp"
                baram:background="#E8E8E8" />

        </LinearLayout>

    </ScrollView>


    <!-- =========================================================
         BOTTOM BAR
         ========================================================= -->

    <LinearLayout
        baram:layout_width="fill_parent"
        baram:layout_height="50dip"
        baram:orientation="horizontal"
        baram:background="#303030">

        <Button
            baram:layout_width="0dip"
            baram:layout_height="fill_parent"
