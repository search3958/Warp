<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:baram="http://schemas.baram.com/apk/res/baram"
    baram:layout_width="match_parent"
    baram:layout_height="match_parent"
    baram:fillViewport="true">

    <LinearLayout
        baram:layout_width="match_parent"
        baram:layout_height="wrap_content"
        baram:orientation="vertical"
        baram:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="baram XML Compatibility Preview"
            baram:textSize="24sp"
            baram:textStyle="bold"/>

        <TextView
            style="@style/SectionDescription"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:text="6 layouts + 26+ standard widgets — rendered by the HTML compatibility layer."/>

        <TextView style="@style/SectionTitle" baram:text="6 Layouts"/>

        <TextView style="@style/ComponentLabel" baram:text="1. LinearLayout"/>
        <LinearLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:orientation="horizontal">
            <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:layout_weight="1" baram:text="A"/>
            <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:layout_weight="2" baram:text="B (weight 2)"/>
            <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:layout_weight="1" baram:text="C"/>
        </LinearLayout>

        <TextView style="@style/ComponentLabel" baram:text="2. RelativeLayout"/>
        <RelativeLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="90dp">
            <Button
                baram:id="@+id/relativeLeft"
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:layout_alignParentLeft="true"
                baram:layout_centerVertical="true"
                baram:text="Left"/>
            <Button
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:layout_alignParentRight="true"
                baram:layout_centerVertical="true"
                baram:text="Right"/>
            <TextView
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:layout_centerInParent="true"
                baram:text="Center"/>
        </RelativeLayout>

        <TextView style="@style/ComponentLabel" baram:text="3. FrameLayout"/>
        <FrameLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="100dp">
            <TextView
                baram:layout_width="match_parent"
                baram:layout_height="match_parent"
                baram:gravity="center"
                baram:background="#e8eefc"
                baram:text="Background"/>
            <Button
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:layout_gravity="center"
                baram:text="Overlay"/>
        </FrameLayout>

        <TextView style="@style/ComponentLabel" baram:text="4. TableLayout / TableRow"/>
        <TableLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:stretchColumns="*">
            <TableRow>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="1,1"/>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="1,2"/>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="1,3"/>
            </TableRow>
            <TableRow>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="2,1"/>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="2,2"/>
                <Button baram:layout_width="0dp" baram:layout_height="wrap_content" baram:text="2,3"/>
            </TableRow>
        </TableLayout>

        <TextView style="@style/ComponentLabel" baram:text="5. GridLayout"/>
        <GridLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:columnCount="3">
            <Button baram:text="1"/>
            <Button baram:text="2"/>
            <Button baram:text="3"/>
            <Button baram:text="4"/>
            <Button baram:text="5"/>
            <Button baram:text="6"/>
        </GridLayout>

        <TextView style="@style/ComponentLabel" baram:text="6. AbsoluteLayout"/>
        <AbsoluteLayout
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="110dp">
            <Button
                baram:layout_width="150dp"
                baram:layout_height="wrap_content"
                baram:layout_x="70dp"
                baram:layout_y="20dp"
                baram:text="x=70 y=20"/>
        </AbsoluteLayout>

        <TextView style="@style/SectionTitle" baram:text="Text &amp; Input"/>
        <TextView style="@style/ComponentLabel" baram:text="TextView"/>
        <TextView style="@style/ComponentBox" baram:text="Hello baram XML" baram:textSize="18sp"/>

        <TextView style="@style/ComponentLabel" baram:text="EditText"/>
        <EditText style="@style/ComponentBox" baram:hint="Type something..." baram:singleLine="true"/>

        <TextView style="@style/ComponentLabel" baram:text="AutoCompleteTextView"/>
        <AutoCompleteTextView style="@style/ComponentBox" baram:hint="Type A..." baram:singleLine="true"/>

        <TextView style="@style/ComponentLabel" baram:text="MultiAutoCompleteTextView"/>
        <MultiAutoCompleteTextView style="@style/ComponentBox" baram:hint="baram, Apple..."/>

        <TextView style="@style/SectionTitle" baram:text="Buttons"/>
        <TextView style="@style/ComponentLabel" baram:text="Button"/>
        <Button style="@style/ComponentBox" baram:text="Button"/>

        <TextView style="@style/ComponentLabel" baram:text="ImageButton"/>
        <ImageButton style="@style/ComponentBox" baram:contentDescription="Camera"/>

        <TextView style="@style/ComponentLabel" baram:text="CheckBox"/>
        <CheckBox style="@style/ComponentBox" baram:checked="true" baram:text="CheckBox"/>

        <TextView style="@style/ComponentLabel" baram:text="RadioButton / RadioGroup"/>
        <RadioGroup style="@style/ComponentBox" baram:orientation="vertical">
            <RadioButton baram:checked="true" baram:text="Option A"/>
            <RadioButton baram:text="Option B"/>
            <RadioButton baram:text="Option C"/>
        </RadioGroup>

        <TextView style="@style/ComponentLabel" baram:text="ToggleButton"/>
        <ToggleButton style="@style/ComponentBox" baram:checked="true"/>

        <TextView style="@style/ComponentLabel" baram:text="Switch"/>
        <Switch style="@style/ComponentBox" baram:checked="true" baram:text="Switch"/>

        <TextView style="@style/SectionTitle" baram:text="Selection"/>
        <TextView style="@style/ComponentLabel" baram:text="Spinner"/>
        <Spinner style="@style/ComponentBox"/>

        <TextView style="@style/ComponentLabel" baram:text="SeekBar"/>
        <SeekBar style="@style/ComponentBox" baram:max="100" baram:progress="55"/>

        <TextView style="@style/ComponentLabel" baram:text="RatingBar"/>
        <RatingBar baram:numStars="5" baram:rating="3.5" baram:stepSize="0.5"/>

        <TextView style="@style/ComponentLabel" baram:text="NumberPicker"/>
        <NumberPicker style="@style/ComponentBox" baram:minValue="0" baram:maxValue="10" baram:value="4"/>

        <TextView style="@style/SectionTitle" baram:text="Progress"/>
        <TextView style="@style/ComponentLabel" baram:text="ProgressBar (indeterminate)"/>
        <ProgressBar/>

        <TextView style="@style/ComponentLabel" baram:text="ProgressBar Horizontal"/>
        <ProgressBar
            style="?baram:attr/progressBarStyleHorizontal"
            baram:layout_width="match_parent"
            baram:max="100"
            baram:progress="65"/>

        <TextView style="@style/SectionTitle" baram:text="Date &amp; Time"/>
        <TextView style="@style/ComponentLabel" baram:text="Chronometer"/>
        <Chronometer baram:textSize="22sp"/>

        <TextView style="@style/ComponentLabel" baram:text="DatePicker"/>
        <DatePicker style="@style/ComponentBox"/>

        <TextView style="@style/ComponentLabel" baram:text="TimePicker"/>
        <TimePicker style="@style/ComponentBox"/>

        <TextView style="@style/ComponentLabel" baram:text="CalendarView"/>
        <CalendarView style="@style/ComponentBox"/>

        <TextView style="@style/SectionTitle" baram:text="Images / Collections / Other"/>
        <TextView style="@style/ComponentLabel" baram:text="ImageView"/>
        <ImageView
            style="@style/ComponentBox"
            baram:layout_width="120dp"
            baram:layout_height="80dp"
            baram:contentDescription="Image"/>

        <TextView style="@style/ComponentLabel" baram:text="ListView"/>
        <ListView style="@style/ComponentBox" baram:layout_width="match_parent" baram:layout_height="130dp"/>

        <TextView style="@style/ComponentLabel" baram:text="GridView"/>
        <GridView
            style="@style/ComponentBox"
            baram:layout_width="match_parent"
            baram:layout_height="120dp"
            baram:numColumns="3"/>

        <TextView style="@style/ComponentLabel" baram:text="ExpandableListView"/>
        <ExpandableListView style="@style/ComponentBox" baram:layout_width="match_parent" baram:layout_height="130dp"/>

        <TextView style="@style/ComponentLabel" baram:text="SearchView"/>
        <SearchView style="@style/ComponentBox" baram:queryHint="Search..."/>

        <TextView style="@style/ComponentLabel" baram:text="WebView"/>
        <WebView style="@style/ComponentBox" baram:layout_width="match_parent" baram:layout_height="100dp"/>

        <TextView style="@style/ComponentLabel" baram:text="VideoView"/>
        <VideoView style="@style/ComponentBox" baram:layout_width="match_parent" baram:layout_height="120dp"/>

        <TextView style="@style/ComponentLabel" baram:text="HorizontalScrollView"/>
        <HorizontalScrollView baram:layout_width="match_parent" baram:layout_height="wrap_content">
            <LinearLayout baram:layout_width="wrap_content" baram:layout_height="wrap_content" baram:orientation="horizontal">
                <Button baram:text="Item 1"/>
                <Button baram:text="Item 2"/>
                <Button baram:text="Item 3"/>
                <Button baram:text="Item 4"/>
                <Button baram:text="Item 5"/>
                <Button baram:text="Item 6"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView style="@style/ComponentLabel" baram:text="ViewFlipper"/>
        <ViewFlipper
            baram:layout_width="match_parent"
            baram:layout_height="100dp"
            baram:autoStart="true"
            baram:flipInterval="2000">
            <TextView baram:layout_width="match_parent" baram:layout_height="match_parent" baram:gravity="center" baram:text="View 1" baram:textSize="24sp"/>
            <TextView baram:layout_width="match_parent" baram:layout_height="match_parent" baram:gravity="center" baram:text="View 2" baram:textSize="24sp"/>
        </ViewFlipper>

        <Space baram:layout_width="match_parent" baram:layout_height="40dp"/>
    </LinearLayout>
</ScrollView>