{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MosaicBoard MB5",
  "scopeName": "source.mb5",
  "patterns": [
    { "include": "#comments" }, { "include": "#directives" }, { "include": "#strings" },
    { "include": "#properties" }, { "include": "#components" },
    { "include": "#script-commands" }, { "include": "#numbers" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.mb5", "match": "//.*$" }, { "name": "comment.line.number-sign.mb5", "match": "^\\s*#.*$" }] },
    "directives": { "patterns": [{ "name": "keyword.control.directive.mb5", "match": "@(?:mainBoard|mainScript|struct|theme)\\b" }, { "name": "entity.name.type.board.mb5", "match": "\\bboard\\s+[A-Za-z_][A-Za-z0-9_-]*" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.mb5", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.mb5", "match": "\\\\." }, { "name": "variable.other.mb5", "match": "\\$\\{?[A-Za-z_][A-Za-z0-9_:]*\\}?" }] }] },
    "properties": { "patterns": [{ "name": "variable.other.property.mb5", "match": "\\.(?:id|display|type|width|size|radius|bgColor|fgColor|placeholder|value|min|max|columns|spacing|opacity|transition|height|gradient)\\b" }, { "name": "support.type.property-name.mb5", "match": "\\b(?:config:title|config:text|config:message|event)\\b" }] },
    "components": { "patterns": [{ "name": "support.class.component.mb5", "match": "\\b(?:alert|text|list|button|card|icon|input|checkbox|switch|slider|progress|divider|scrollbox|topbar|navigation|dropdown|tab|spacing|horizontal|vertical|grid|snackbar|gradient|opacity)\\b(?=\\s*[({])" }] },
    "script-commands": { "patterns": [{ "name": "keyword.control.mb5", "match": "\\b(?:proc|fn|return|if|elseif|else|while|foreach|break|continue|catch|error|assert|global)\\b" }, { "name": "support.function.mb5", "match": "\\b(?:set|let|expr|incr|append|list|llength|lindex|lappend|dict|string|json\\.(?:get|has)|ui\\.(?:set|get)|fetch|after|wait|puts|print)\\b" }, { "name": "variable.other.mb5", "match": "\\$\\{?[A-Za-z_][A-Za-z0-9_:]*\\}?" }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.mb5", "match": "(?<![A-Za-z_])\\b\\d+(?:\\.\\d+)?%?\\b" }, { "name": "constant.other.color.rgb-value.mb5", "match": "#[0-9A-Fa-f]{6}\\b" }] }
  }
}
