// Warp Language v3 - Refined Swift-like Syntax
@App var warpVersion = 2
@App var themeColor = "blue"
@App var currentScreen = "main"

// ==========================================
// Main Screen
// ==========================================
Screen main {
    
    Header("Warp Demo") {
        @State var headerStatus = ""

        Button("再読み込み \(headerStatus)") {
            headerStatus = ": 少々お待ちください"
            reset()
        }
    }
    
    Button("FAB") { }
        .frame(width: 100% - 40, height: 40)
        .position(bottom: 20, left: 20)
        .zIndex(10)
    
    @State var mainText = "..."

    Text("これは新しい、ネイティブとWeb技術が融合する言語です。気になる反応は \(mainText)")
    
    Card("内容変更") {
        Text("クリックすると表示内容が変更されます")
        
        HStack {
            Button("👍") {
                mainText = "良いみたいです!"
            }
            
            Button("🤔") {
                mainText = "あまり良くないようですね。"
            }
            .offset(left: 10)
            
            @State var buttonStatus = "disabled"

            Button("❌") {
                mainText = "最悪ですね"
            }
            .status(buttonStatus)
            .id("disabledButton")
            
            Button("ボタンを有効化") {
                buttonStatus = "unset"
            }
        }

        @State var currentColor = "yellow"
        Button("Click") {
            currentColor = "red"
        }
        .backgroundColor(currentColor)
        .onLongPress {
            currentColor = "blue"
        }
    }
    
    Card("ボタン類") {
        Text("通常ボタン")
        
        HStack {
            Button("戻る") { }
            
            TonalButton("注文") { }
                .width(.max)
        }
        
        Card("使用例") {
            Text("Button(\"戻る\") {\n  // ここにアクションを書く\n}")
        }
        .backgroundColor("#091529")
        .foregroundColor("#eeeeff")
    }
    
    Card("複数画面") {
        Button("Screen1に移動する") {
            currentScreen = "screen1"
        }
    }
    
    Card("入力") {
        @State var switchValue = false
        @State var isSwitchDisabled = false
        
        Toggle(isOn: $switchValue)
            .disabled(isSwitchDisabled)
        
        Text("スイッチの状態は \(switchValue) となっています")
        
        Button("スイッチを無効化") {
            isSwitchDisabled = true
        }
        
        Button("スイッチを有効化") {
            isSwitchDisabled = false
        }
        
        @State var sliderValue = 50.0
        Slider(value: $sliderValue, in: 0...100, step: 1)
        
        Text("スライダー値は \(sliderValue) です。")
        
        @State var inputText = "私の名前はです。"
        TextField("自己紹介文を入力", text: $inputText)
            .id("nameInput")
        
        @Storage var savedName = ""
        @State var saveStatus = ""

        HStack {
            Button("保存") {
                savedName = inputText
                saveStatus = "保存完了"
                wait(1)
                saveStatus = ""
            }
            
            Button("復元") {
                inputText = savedName
                saveStatus = "復元完了"
                wait(1)
                saveStatus = ""
            }
        }
        
        Text(saveStatus)
    }
    
    Card("小計算機") {
        @State var expression = ""
        @State var showDebug = true
        @State var calculationResult = 0
        
        Text(expression)
            .foregroundColor(.gray)
            .hidden(!showDebug)
            .id("calcDebug")
        
        Text("\(calculationResult)")
        
        HStack {
            TonalButton("1") { expression += "1" }
            TonalButton("2") { expression += "2" }
            TonalButton("3") { expression += "3" }
            Button("+") { expression += "+" }
        }
        
        HStack {
            TonalButton("4") { expression += "4" }
            TonalButton("5") { expression += "5" }
            TonalButton("6") { expression += "6" }
            Button("-") { expression += "-" }
        }
        
        HStack {
            TonalButton("7") { expression += "7" }
            TonalButton("8") { expression += "8" }
            TonalButton("9") { expression += "9" }
            Button("×") { expression += "*" }
        }
        
        HStack {
            TonalButton("0") { expression += "0" }
            Button("=") { 
                calculationResult = evaluate(expression) 
            }
            .backgroundColor(.yellow)
            
            TonalButton("C") { 
                expression = "0"
                calculationResult = 0 
            }
            .backgroundColor(.yellow)
            
            Button("÷") { expression += "/" }
        }
        
        @State var debugToggleText = "途中式を非表示"
        Button(debugToggleText) {
            showDebug.toggle()
            debugToggleText = showDebug ? "途中式を非表示" : "途中式を表示"
        }
    }
    
    Card("要素追加") {
        @State var actionType = ""
        HStack {
            Button("追加") { 
                actionType = "add"
                ctrl() 
            }
            Button("1つ削除") { 
                actionType = "del"
                ctrl() 
            }
            Button("クリア") { 
                actionType = "clr"
                ctrl() 
            }
        }
        
        VStack { }
            .id("cList")
    }
}

// ==========================================
// Screen 1
// ==========================================
Screen screen1 {
    Header("Screen") { }
    
    Text("Screen1の内容です。")
    
    Button("mainに戻る") {
        currentScreen = "main"
    }
}

// ==========================================
// Logic Blocks
// ==========================================
func ctrl() {
    if actionType == "add" {
        container("cList").add(Button("ボタンを追加") { })
    }
    
    if actionType == "del" {
        container("cList").removeLast()
    }
    
    if actionType == "clr" {
        container("cList").clear()
    }
}
