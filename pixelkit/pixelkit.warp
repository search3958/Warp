block(pixelkit_reset){
    var(screenX)
    var(screenY)
    var(pixelData)
    var(pixelCount)
    var(pxlLine)
    pixelData.null
}

block(pixelkit_start){
    pixelCount.screenX
    pixelCount.$*screenY
    loop(pixelCount){
        pixelData.$+"0"
    }
}

